# --- safestore plugin (env overrides; usually not needed after `sf auth login`) ---
# OPENCODE_SAFESTORE_URL=https://opencode-safestore.<your-subdomain>.workers.dev
# OPENCODE_SAFESTORE_TOKEN=sf_...          # API key from your account dashboard
# OPENCODE_SAFESTORE_KEY=...               # the master key (delivered by the CLI)

# --- publish script (optional) ---
# SAFESTORE_URL=https://opencode-safestore.<your-subdomain>.workers.dev
# ADMIN_TOKEN=...                          # matches the Worker secret ADMIN_TOKEN
